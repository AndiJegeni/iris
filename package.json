{
  "name": "iris-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "dev": "bun packages/cli/src/index.ts",
    "test": "bun test",
    "build": "bun run --filter '@andijegeni/iris' build && bun run --filter 'useiris' build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
